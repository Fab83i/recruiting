# Copie ce fichier en .env et adapte les valeurs. Ne JAMAIS commiter le vrai .env.

# Connexion PostgreSQL
DATABASE_URL=postgresql://suivi:suivi@postgres:5432/suivi

# JWT — génère une clé avec : python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGER_CETTE_CLE
JWT_EXPIRE_MINUTES=480

# Compte admin initial (créé au premier démarrage)
ADMIN_EMAIL=fabiencalvo@gmail.com
ADMIN_PASSWORD=CHANGER_CE_MOT_DE_PASSE

# CORS : origine du front (ou * pour tout autoriser en dev)
CORS_ORIGINS=*
