# Copie ce fichier en ".env" et remplis les valeurs. Ne JAMAIS commiter le vrai .env.

# --- PostgreSQL ---
POSTGRES_USER=suivi
POSTGRES_PASSWORD=CHANGER_CE_MOT_DE_PASSE
POSTGRES_DB=suivi

# --- Backend (doit pointer vers le service postgres ci-dessus) ---
DATABASE_URL=postgresql://suivi:CHANGER_CE_MOT_DE_PASSE@postgres:5432/suivi

# Clé JWT — génère-la avec :
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGER_CETTE_CLE_ALEATOIRE
JWT_EXPIRE_MINUTES=480

# Compte admin initial (créé au premier démarrage s'il n'existe pas)
ADMIN_EMAIL=fabiencalvo@gmail.com
ADMIN_PASSWORD=CHANGER_CE_MOT_DE_PASSE_ADMIN

# CORS (avec le proxy nginx, le front appelle /api en même origine : * convient)
CORS_ORIGINS=*
